{
  "name": "case-tracker",
  "version": "2.0.0",
  "description": "Case management REST API built with Express.js and PostgreSQL",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "test": "NODE_ENV=test mocha --timeout 10000 --exit test/**/*.test.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:test": "NODE_ENV=test knex migrate:latest",
    "seed": "knex seed:run",
    "seed:test": "NODE_ENV=test knex seed:run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.22.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "morgan": "^1.10.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "dotenv": "^17.3.1",
    "mocha": "^11.7.5"
  }
}
